# Isolate the BrowserPod routes only.
/browserpod
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: cross-origin-isolated=(self)

/browserpod.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: cross-origin-isolated=(self)
